# Copy to .env.local for local development. On Vercel, add each of these
# under Project Settings → Environment Variables instead (see README.md
# "Deploying to Vercel" for exactly which environments need which keys).

# --- Clerk (Dashboard → API Keys) ---------------------------------------
# NEXT_PUBLIC_* keys are inlined into the client bundle at build time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- MongoDB Atlas --------------------------------------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=yourApp
MONGODB_DB=urpadel

# --- Secrets ---------------------------------------------------------------
# Encrypts per-club integration credentials (currently: Playtomic API
# secrets) at rest, and signs data-deletion confirmation tokens. 32 bytes as
# 64 hex chars — generate with:
#   openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# --- Email (Resend) --------------------------------------------------------
# Sends the self-service data-deletion confirmation email. Get a key at
# resend.com. Without it, the /data-deletion flow can't send (in local dev
# the confirmation link is logged to the server console instead).
RESEND_API_KEY=
# From address for those emails. In production this MUST be on a
# Resend-verified domain; defaults to Resend's shared test sender otherwise.
DATA_DELETION_FROM_EMAIL=urPadel <onboarding@resend.dev>

# --- OCR (Accountant Assistant, cloud engine only) -------------------------
# Google Cloud Vision API key. Only needed for clubs whose Accountant
# Assistant OCR engine is set to "cloud" by the superadmin; the self-hosted
# "tesseract" engine needs no key. Create one in Google Cloud Console with the
# Vision API enabled.
GOOGLE_VISION_API_KEY=

# --- App -------------------------------------------------------------------
# Default super admin email — has full access even with no AppUser record.
SUPERADMIN_EMAIL=m.ignaczak.92@gmail.com
# Canonical production URL, used for metadata (Open Graph / canonical links).
# Set to your Vercel domain, e.g. https://urpadel.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
